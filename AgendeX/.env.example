# Telegram Bot (crear con @BotFather)
TELEGRAM_BOT_TOKEN=tu_token_aqui

# Claude / Anthropic (motor conversacional) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=tu_api_key_de_anthropic
# Opcional, por defecto claude-haiku-4-5-20251001 (el más barato y rápido, de sobra para esta tarea)
ANTHROPIC_MODEL=
# Opcional, tope de tokens de salida por respuesta (por defecto 512)
ANTHROPIC_MAX_TOKENS=

# Google Calendar (Cuenta de servicio)
GOOGLE_CLIENT_EMAIL=tu_email_de_servicio@tu_proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=tu_calendario_id@google.com

# Puerto del servidor
PORT=3000

# URL pública (solo en producción, ej. Render). Si se define, el bot usa
# webhook en vez de long polling. Déjala vacía en local.
PUBLIC_URL=

# Opcional: secreto para validar que las peticiones al webhook vienen
# realmente de Telegram. Si no la defines, se deriva automáticamente del
# TELEGRAM_BOT_TOKEN (no hace falta rellenarla).
TELEGRAM_WEBHOOK_SECRET=
